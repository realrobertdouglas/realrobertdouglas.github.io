source 'https://rubygems.org'

# The same Jekyll version and plugins that GitHub Pages builds the live site with,
# so a local preview matches what gets published. `bundle update github-pages` to follow GitHub.
gem 'github-pages', group: :jekyll_plugins

# Needed by `jekyll serve` on Ruby 3+
gem 'webrick', '~> 1.8'

# Preview with:  LANG=en_US.UTF-8 PAGES_DISABLE_NETWORK=1 bundle exec jekyll serve
# LANG: the default theme's Sass fails without a UTF-8 locale.
# PAGES_DISABLE_NETWORK: skips GitHub API lookups the site doesn't use, which take ~15s per build.
